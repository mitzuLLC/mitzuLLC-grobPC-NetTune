<?xml version="1.0" encoding="utf-8"?>
<!--
  grobPC NetTune — ConfuserEx2 obfuscation profile (anti-theft / anti-reverse). TEMPLATE: the CI step fills
  @@NETCORE@@ / @@DESKTOP@@ with the .NET 8 shared framework folders of the runner, so ConfuserEx can resolve
  System.Runtime / PresentationFramework / System.Windows.Forms while it rewrites the module.

  .NET 8 note: grobPC-NetTune.exe is only the native apphost; the managed code (the thing to protect) is
  grobPC-NetTune.dll. Paths are relative to THIS file (build/): baseDir ..\publish -> outputDir ..\obf. CI copies
  obf\grobPC-NetTune.dll over a copy of publish = protected\, then smoke-tests protected\grobPC-NetTune.exe /selftest.

  Layers (CoreCLR-safe), same set as grobyq:
    anti ildasm  — marks the module so ildasm refuses it
    constants    — encrypts string / numeric constants (AerialOS rules, URLs, cmdlet text no longer plaintext)
    ctrl flow    — scrambles method control flow
    ref proxy    — hides direct calls behind proxy methods
    anti debug   — resists attaching a managed debugger (safe mode)
  Not used: anti tamper / anti dump (crash on CoreCLR) and rename (WPF / XAML resolve types by name).
-->
<project outputDir="..\obf" baseDir="..\publish" xmlns="http://confuser.codeplex.com">
  <rule pattern="true" preset="none" inherit="false">
    <protection id="anti ildasm" />
    <protection id="constants" />
    <protection id="ctrl flow" />
    <protection id="ref proxy" />
    <protection id="anti debug" />
  </rule>

  <module path="grobPC-NetTune.dll" />

  <!-- schema order: rule*, packer?, module+, probePath*, plugin* -->
  <probePath>@@NETCORE@@</probePath>
  <probePath>@@DESKTOP@@</probePath>
</project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>grobPC-NetTune</AssemblyName>
    <RootNamespace>GrobPC.NetTune.App</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>grobPC NetTune by mitzu LLC</Product>
    <Company>mitzu LLC</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- NetTune writes the network driver key (Control\Class) and NDIS\Parameters, runs Set-NetAdapterRss and
         netsh, restarts the adapter: needs elevation, the same as the .cmd launcher (/elevated). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- the engine, platform-neutral and unit-tested on Linux; the app adds the Windows collectors (Win/*.cs) -->
    <ProjectReference Include="..\src\NetTune.Core\NetTune.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
  </ItemGroup>

</Project>
